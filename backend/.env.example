# Database Configuration (MySQL 8)
MYSQL_USER=hair_ai_user
MYSQL_PASSWORD=hair_ai_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=hair_ai

# Optional: Override with direct URL (e.g., SQLite for standalone local testing)
# DATABASE_URL=sqlite:///./storage/hair_ai_portable.db

# Security & Secrets
SECRET_KEY=change-this-in-production-to-a-very-secure-random-32-byte-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Image Constraints
MAX_IMAGE_SIZE_BYTES=10485760
MIN_IMAGE_DIMENSION=512

# Image Quality Thresholds
BLUR_THRESHOLD_LAPLACIAN=100.0
BRIGHTNESS_MIN=40.0
BRIGHTNESS_MAX=220.0
CONTRAST_MIN=25.0

